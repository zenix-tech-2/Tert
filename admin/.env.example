# Same database as the member app (Supabase pooler URL)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Optional: shown in the admin settings page
MEMBER_APP_URL=https://your-member-app.vercel.app
# Same SMM keys as the member app (used for provider balances)
PEAKERR_API_KEY=
SMMAFRICA_API_KEY=
