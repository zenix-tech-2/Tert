# ---- Database (Supabase) ------------------------------------------------
# Use the Supabase "Transaction pooler" connection string (port 6543) on Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- App -----------------------------------------------------------------
# Public HTTPS origin of the deployment (used for AshTechPay notify_url).
APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/XXXXXXXX

# ---- AshTechPay Direct API (https://doc.ashtechpay.com) -----------------
# Leave empty to run the activation flow in DEMO mode.
ASHTECHPAY_API_KEY=ak_xxxxxxxxxxxxxxxxx
ASHTECHPAY_USER_ID=
ASHTECHPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
ASHTECHPAY_BASE_URL=https://www.ashtechpay.com/v1

# Optional: merchant FX rates (currency units per 1 USD) for currencies not in src/lib/pricing.ts
# DBI_FX_RATES={"MGA":4500}

# ---- DBI business settings (all optional, defaults shown) --------------
# DBI_REFERRAL_COMMISSION=1000        FCFA paid to sponsor per activated referral
# DBI_CONVERSION_RATE=600             XAF per 1 USD for wallet conversion
# DBI_TRANSFER_FEE_PCT=10             Transfert DBI fee
# DBI_ADS_COST_PER_VIEW=3             FCFA charged to advertisers per verified view
# DBI_ADS_PUBLISHER_PER_VIEW=1.8      FCFA paid to diffuseurs per verified view
# DBI_ADS_MIN_IMAGE=5000  DBI_ADS_MIN_VIDEO=10000
# DBI_VENDOR_SUBSCRIPTION=10000 DBI_VENDOR_EDIT_PRICE=990 DBI_VENDOR_SHOP_FEE=990 DBI_VENDOR_PUBLISH_PRICE=0
#
# Database setup on Supabase: run supabase/schema.sql then supabase/seed.sql in the SQL editor.

# ---- SMM (Peakerr) -------------------------------------------------------
# Leave empty to show the SMM module as "Bientôt".
PEAKERR_API_KEY=
# PEAKERR_API_URL=https://peakerr.com/api/v2
# DBI_SMM_MARKUP_PCT=40      markup over Peakerr rate (converted USD→XAF at DBI_CONVERSION_RATE)
# DBI_SMM_MIN_PRICE=100      minimum charge in FCFA per order
# Second SMM provider (optional — enable one or both)
SMMAFRICA_API_KEY=
# SMMAFRICA_API_URL=https://smm.africa/api/v3
